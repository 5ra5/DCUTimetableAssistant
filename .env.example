PORT=8080 # Web App port
OLLAMA_MODEL=llama3.2:3b # Agent model
OLLAMA_HOST="http://host.docker.internal:11434"
#OLLAMA_HOST="http://ollama:11434"
MIN_ROOMS=2
LLM_TIMEOUT_S=60
LOG_LEVEL=INFO

# Using a model via API
OLLAMA_API_KEY= # API KEY
OLLAMA_USE_API_KEY=False # Set to True only if OLLAMA_API_KEY is set
DB_PATH=data/timetable.db
TOOL_TURN_TOKENS=512 # tokens for each model call while tools are still needed
SHORT_TOKENS=80 # decision and note calls
MAX_TOOL_TURNS=4 # most model calls in the tool phase (a feature never needs more than len(required) + 1)
KEEP_MODEL_ALIVE_FOR=30m
